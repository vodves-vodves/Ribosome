    "e2e": "wxt build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
